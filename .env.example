# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
NEXT_PUBLIC_APP_URL="https://pay.example.com"
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-at-least-12-characters"
# Optional initial regular administrator
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-characters"

# Optional overrides for what is shown next to the logos on pages and PDF receipts.
# Unset = the default shown here. Set to "" to leave that line off.
# NEXT_PUBLIC_ORG_NAME="Consistency"
# NEXT_PUBLIC_ORG_SUBTITLE="Plan • Persist • Achieve"
# NEXT_PUBLIC_ORG_ENQUIRY="For any enquiry, call 0240000000"
# NEXT_PUBLIC_ORG_WEBSITE="pay.example.com"
# Fallback SMS sender ID (max 11 letters/numbers)
# NEXT_PUBLIC_SMS_SENDER="Consistency"
